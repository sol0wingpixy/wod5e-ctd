<section class='tab {{ tab.cssClass }}' data-tab='{{ tab.id }}' data-group='{{ tab.group }}'>
  <div class='flexrow'>
    <div class='item-list'>
      <div class='flexrow flex-center'>
        <div class='item-header'>{{localize 'WOD5E.CTD.Arts'}}</div>
        <div class='item-controls'>
          <a
            class='item-control search-data-item flex-center'
            data-action='searchItem'
            title="{{localize 'WOD5E.Search'}}"
            data-type='cantrip'
          >
            <i class='fa-solid fa-magnifying-glass'></i>
          </a>
          <a
            class='item-control add-art flex-center'
            title="{{localize 'WOD5E.CTD.AddArt'}}"
            data-action='addArt'
          >
            <i class='fas fa-plus'></i>
          </a>
        </div>
      </div>
      <ul class='cantrips-display-tree category'>
        {{#each arts as |art key|}}
          {{#if art.visible}}
            <span class='parent flexrow'>
              <div
                class='
                  icon
                  category-select
                  {{#if art.selected}}
                    selected
                  {{/if}}
                '
                data-action='selectArt'
                data-art='{{ key }}'
              ></div>
              <a class='select-label' data-action='selectArt' data-art='{{ key }}'>
                {{ art.displayName }}
              </a>
              <div class='item-controls'>
                <!-- Icon to roll the art with an attribute and/or skill combination -->
                {{#if (and (ne key "rituals") (ne key "ceremonies"))}}
                  <a
                    class='rollable art-dice'
                    data-action='roll'
                    title="{{localize 'WOD5E.RollList.Label'}}"
                    data-value-paths='arts.{{ key }}.value'
                    data-art='{{ key }}'
                    data-select-dialog='true'
                  >
                    <i class='fa-solid fa-dice-d10'></i>
                  </a>
                {{/if}}
                <!-- Icon to show the art description to the chat-->
                <a
                  class='item-control art-chat'
                  data-action='artChat'
                  title="{{localize 'WOD5E.ItemsList.ShowToChat'}}"
                  data-art='{{ key }}'
                >
                  <i class='fas fa-comment-alt'></i>
                </a>
                <!-- Icon to delete the art (as long as it doesn't have any cantrips) -->
                {{#if (eq art.cantrips.length 0)}}
                  <a
                    class='item-control art-delete'
                    data-action='removeArt'
                    title="{{localize 'WOD5E.Delete'}}"
                    data-art='{{ key }}'
                  >
                    <i class='fas fa-trash'></i>
                  </a>
                {{/if}}
              </div>
              {{#if (and (ne key "rituals") (ne key "ceremonies"))}}
                <!-- Art dots -->
                <div class='cantrip-resource-dots'>
                  <div
                    class='resource-value'
                    data-value='{{ art.value }}'
                    data-name='system.arts.{{ key }}.value'
                  >
                    <!-- Empty box (for setting back to 0), and then iterate through the rest of the art dots -->
                    <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
                    {{#numLoop 5}}
                      <span
                        class='resource-value-step'
                        data-action='dotCounterChange'
                        data-index='{{ this }}'
                      ></span>
                    {{/numLoop}}
                  </div>
                </div>
              {{/if}}
            </span>
            <ul>
              {{#each art.cantrips as |cantrip key|}}
                <li>
                  <span>
                    <div
                      class='
                        icon
                        cantrip-select
                        {{#if cantrip.system.selected}}
                          selected
                        {{/if}}
                      '
                      data-action='selectArtCantrip'
                      data-cantrip='{{ cantrip.id }}'
                      style="background-image: url('{{ cantrip.img }}');"
                    ></div>
                    <a class='select-label' data-action='selectArtCantrip' data-cantrip='{{ cantrip.id }}'>{{ cantrip.name }}</a>
                  </span>
                </li>
              {{/each}}
            </ul>
          {{/if}}
        {{/each}}
      </ul>
    </div>
    <div class='cantrips-list item-list'>
      {{#if selectedArt}}
        <div class='art category collapsible-container'>
          <div class='flex-center item-header collapsible' data-action='toggleCollapse'>
            <div class='item-name'>
              {{ selectedArt.displayName }}
              <a
                class='item-control item-create'
                data-action='createItem'
                title="{{localize 'WOD5E.CTD.AddArt'}}"
                data-type='cantrip'
                data-subtype='{{ selectedArt.id }}'
              >
                <i class='fas fa-plus'></i>
              </a>
            </div>
          </div>
          <div class='art-description collapsible-content'>
            <prose-mirror
              name='system.arts.{{ selectedArt.id }}.description'
              value='{{ selectedArt.description }}'
              toggled='true'
              compact='true'
            >
              {{{ enrichedSelectedArtDescription }}}
            </prose-mirror>
          </div>
        </div>
      {{else}}
        <div class='art category flex-center'>
          {{localize 'WOD5E.CTD.NoArtSelected'}}
        </div>
      {{/if}}

      {{#if selectedArtCantrip}}
        <div class='art category'>
          <div class='flex-center'>
            <div class='flexrow'>
              <span class='item-name item-header'>
                <!-- Icon to roll a cantrip's dicepool -->
                {{#if (isNotEmpty selectedArtCantrip.system.dicepool)}}
                  <a
                    class='item-image rollable-item'
                    data-action='rollItem'
                    data-item-uuid='{{ selectedArtCantrip.uuid }}'
                  >
                    <i class='fa-solid fa-dice-d10'></i>
                  </a>
                {{/if}}
                {{ selectedArtCantrip.name }}
              </span>
              <div class='item-controls flex-group-right'>
                <!-- Icon to edit the cantrip -->
                <a
                  class='item-control item-edit'
                  data-action='itemOpen'
                  title="{{localize 'WOD5E.Edit'}}"
                  data-item-id='{{ selectedArtCantrip._id }}'
                >
                  <i class='fas fa-edit'></i>
                </a>
                <!-- Icon to display the cantrip in chat -->
                <a
                  class='item-control item-chat'
                  data-action='itemChat'
                  title="{{localize 'WOD5E.ItemsList.ShowToChat'}}"
                  data-item-id='{{ selectedArtCantrip._id }}'
                >
                  <i class='fas fa-comment-alt'></i>
                </a>
                <!-- Icon to delete the cantrip -->
                <a
                  class='item-control item-delete'
                  data-action='itemDelete'
                  title="{{localize 'WOD5E.Delete'}}"
                  data-item-id='{{ selectedArtCantrip._id }}'
                >
                  <i class='fas fa-trash'></i>
                </a>
              </div>
            </div>
          </div>
          <div class='art-description'>
            <div class='flex-center flexrow'>
              <div class='flex-center'>
                <div>
                  <b>{{localize "WOD5E.Level"}}: {{ selectedArtCantrip.system.level }}</b>
                </div>
              </div>
              {{#ifgr selectedArtCantrip.system.cost 0}}
                <div class='flex-center'>
                  <div>
                    <b>
                      {{localize 'WOD5E.ItemsList.Cost'}}:{{ selectedArtCantrip.system.cost }}
                      {{localize 'WOD5E.CTD.RouseChecks'}}
                      <!-- Icon to roll a cantrip's dicepool -->
                      <a
                        class='item-image rollable-item'
                        data-action='roll'
                        data-disable-basic-dice='true'
                        data-use-absolute-value='true'
                        data-selectors="rouse{{#ifeq selectedArt.id 'oblivion'}}oblivion-rouse{{/ifeq}}"
                        data-absolute-value='{{ selectedArtCantrip.system.cost }}'
                        data-label="{{localize 'WOD5E.CTD.RousingBlood'}} - {{ selectedArtCantrip.name }}"
                        data-increase-hunger='true'
                        title="{{localize 'WOD5E.CTD.RollRouse'}}"
                        data-item-id='{{ selectedArtCantrip.id }}'
                      >
                        <i class='fa-solid fa-dice-d10'></i>
                      </a>
                    </b>
                  </div>
                </div>
              {{/ifgr}}
            </div>
            {{#if selectedArtCantripDescription}}
              <div class='cantrip-description'>
                {{{ selectedArtCantripDescription }}}
              </div>
            {{/if}}
          </div>
        </div>
      {{else}}
        <div class='art category flex-center'>
          {{localize 'WOD5E.CTD.NoCantripSelected'}}
        </div>
      {{/if}}
    </div>
  </div>
</section>
